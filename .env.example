# Prometheus URL (port-forwarded from istio-system)
PROMETHEUS_URL=http://localhost:9090

# Kubernetes namespace for test services
K8S_NAMESPACE=default

# Collector polling interval in seconds
POLL_INTERVAL_SECONDS=60

# GitHub settings (required for Module 5 — not needed for Module 1)
# GITHUB_TOKEN=
# POLICY_REPO_NAME=
