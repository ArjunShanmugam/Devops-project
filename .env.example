# Prometheus URL (port-forwarded from istio-system)
PROMETHEUS_URL=http://localhost:9090

# Kubernetes namespace for test services
K8S_NAMESPACE=default

# Collector polling interval in seconds
POLL_INTERVAL_SECONDS=60

# Inferencer thresholds
MIN_REQUEST_COUNT=5
MAX_STALENESS_WINDOWS=3
STALE_RULE_AGE_WINDOWS=10

# GitHub settings (required for Module 5)
GITHUB_TOKEN=your_github_token_here
POLICY_REPO_NAME=yourname/zt-policy-repo
